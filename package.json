{
    "name": "petals-3d",
    "version": "1.0.0",
    "description": "Open source 3D drawing editor built with React Three Fiber",
    "private": true,
    "type": "module",
    "license": "MIT",
    "scripts": {
        "dev": "vite --port 3000",
        "build": "vite build",
        "preview": "vite preview --port 3000",
        "lint": "eslint src",
        "lint:fix": "eslint src --fix",
        "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"*.{js,json,md}\"",
        "format:check": "prettier --check \"src/**/*.{js,jsx,css}\" \"*.{js,json,md}\"",
        "prepare": "git config core.hooksPath .githooks || exit 0"
    },
    "lint-staged": {
        "*.{js,jsx}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{css,json,md}": [
            "prettier --write"
        ]
    },
    "dependencies": {
        "@react-three/drei": "^10.7.8",
        "@react-three/fiber": "^9.7.0",
        "@react-three/postprocessing": "^3.1.1",
        "@tabler/icons-react": "^3.46.0",
        "@tailwindcss/vite": "^4.3.3",
        "axios": "^1.20.0",
        "idb-keyval": "^6.3.0",
        "react": "~19.2.8",
        "react-dom": "~19.2.8",
        "react-router-dom": "^7.18.3",
        "react-toastify": "^11.1.0",
        "tailwindcss": "^4.3.3",
        "three": "^0.186.0",
        "uuid": "^14.0.2",
        "zustand": "^5.0.15"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@vitejs/plugin-react": "^6.1.1",
        "eslint": "^10.10.0",
        "eslint-plugin-better-tailwindcss": "^4.7.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.6",
        "globals": "^17.12.0",
        "lint-staged": "^17.5.1",
        "prettier": "^3.9.6",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "vite": "^8.3.0"
    }
}
